[Unit]
Description=Aion staging off-instance database and key backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=aion-staging-recovery-failure@%n.service

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/opt/aion-staging/recovery/backup.env
ExecStart=/bin/sh /opt/aion-staging/recovery/backup.sh snapshot
TimeoutStartSec=20min
