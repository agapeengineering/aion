graph {
    graph [rankdir=LR];
    node [label="\N",
        shape=plaintext
    ];
    edge [color=gray50,
        minlen=2,
        style=dashed
    ];
"rate_limit_buckets" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">rate_limit_buckets</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="namespace"><u><FONT>namespace</FONT></u> <FONT> [VARCHAR(48)]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="subject_digest"><u><FONT>subject_digest</FONT></u> <FONT> [BYTEA]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="window_start"><u><FONT>window_start</FONT></u> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT>attempts</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT>expires_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
"users" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">users</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [UUID]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT>created_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT>email</FONT> <FONT> [VARCHAR(254)]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="verified_at"><FONT>verified_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
"email_challenges" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">email_challenges</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [UUID]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT>attempts</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="browser_digest"><FONT>browser_digest</FONT> <FONT> [BYTEA]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="code_digest"><FONT>code_digest</FONT> <FONT> [BYTEA]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="consumed_at"><FONT>consumed_at</FONT> <FONT> [TIMESTAMP]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT>created_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT>email</FONT> <FONT> [VARCHAR(254)]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT>expires_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="invalidated_at"><FONT>invalidated_at</FONT> <FONT> [TIMESTAMP]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purpose"><FONT>purpose</FONT> <FONT> [VARCHAR(16)]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT>user_id</FONT> <FONT> [UUID]</FONT></TD></TR></TABLE></FONT>>];
"sessions" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [UUID]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="absolute_expires_at"><FONT>absolute_expires_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT>created_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="csrf_digest"><FONT>csrf_digest</FONT> <FONT> [BYTEA]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT>expires_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="last_seen_at"><FONT>last_seen_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="reverified_at"><FONT>reverified_at</FONT> <FONT> [TIMESTAMP]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="revoked_at"><FONT>revoked_at</FONT> <FONT> [TIMESTAMP]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_digest"><FONT>token_digest</FONT> <FONT> [BYTEA]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT>user_id</FONT> <FONT> [UUID]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
"verification_mail" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">verification_mail</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [UUID]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="acceptance_unknown"><FONT>acceptance_unknown</FONT> <FONT> [BOOLEAN]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="attempts"><FONT>attempts</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="challenge_id"><FONT>challenge_id</FONT> <FONT> [UUID]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="encrypted_payload"><FONT>encrypted_payload</FONT> <FONT> [BYTEA]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at"><FONT>expires_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="next_attempt_at"><FONT>next_attempt_at</FONT> <FONT> [TIMESTAMP]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="provider_message_id"><FONT>provider_message_id</FONT> <FONT> [VARCHAR(64)]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT>status</FONT> <FONT> [VARCHAR(16)]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
"users":"id" -- "email_challenges":"user_id" [taillabel=<<FONT>{0,1}</FONT>>,headlabel=<<FONT>0..N</FONT>>];
"users":"id" -- "sessions":"user_id" [taillabel=<<FONT>1</FONT>>,headlabel=<<FONT>0..N</FONT>>];
"email_challenges":"id" -- "verification_mail":"challenge_id" [taillabel=<<FONT>1</FONT>>,headlabel=<<FONT>0..N</FONT>>];
}
