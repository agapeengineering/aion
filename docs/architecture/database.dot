digraph Aion {
  graph [rankdir=TB, bgcolor="#faf6ee", pad="0.4", nodesep="0.4", ranksep="0.6", fontname="Helvetica", label="AION  /  DATA MAP\nLocal backend source and planned R2 additions — public R1 remains on-device", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#62584d", fillcolor="#fffdf8", margin="0.22,0.16"];
  edge [fontname="Helvetica", fontsize=10, color="#62584d", arrowsize=0.7];
  subgraph cluster_current {
    label="IMPLEMENTED LOCALLY · PostgreSQL · solid boxes"; color="#1a1a1a"; penwidth=1.5; margin=22;
    users [label="USERS\nVerified email identity\nCreated only after code verification", fillcolor="#1a1a1a", fontcolor="#faf6ee"];
    sessions [label="SESSIONS\nUser FK · token/CSRF digests\nIdle + absolute expiry · revocation"];
    challenges [label="EMAIL_CHALLENGES\nEmail · purpose · code/browser digests\nExpiry · attempts · consumed/invalidated"];
    limits [label="RATE_LIMIT_BUCKETS\nKeyed email/IP identity\nWindow · count · expiry"];
    verification [label="VERIFICATION_MAIL\nChallenge FK · sealed payload\nStatus · retries · expiry"];
    profiles [label="PROFILES\nUser PK/FK · inputs/preferences\nMonotonic revision · reset tombstone"];
    mutations [label="PROFILE_MUTATIONS\nOwner + operation UUID · keyed digest\nResult revision · 30-day retention"];
    prefs [label="REMINDER_PREFERENCES\nUser FK · explicit consent\nDaily/weekly · timezone · next due"];
    delivery [label="REMINDER_MAIL + EMAIL_EVENTS\nLogical send key · retries/status\nProvider metadata · chosen phrase ID"];
    suppression [label="SUPPRESSIONS\nKeyed email identifier · reason\nIndependent of active account"];
    profiles -> prefs [label="saved profile required"];
    prefs -> delivery [label="eligible scheduled snapshot"];
    suppression -> delivery [label="blocks sending"];
    deletion [label="DELETION_LEDGER\nOld UUID · keyed email marker · time\nNo FK to active user"];
    users -> profiles [label="one to zero/one"];
    users -> mutations [label="one to many"];
    users -> sessions [label="one to many"];
    users -> challenges [label="optional owner; reverify reserved"];
    challenges -> verification [label="one to zero/one"];
    limits -> challenges [label="protects; no FK", style=dashed];
  }
  subgraph cluster_future {
    label="PLANNED R2 · not implemented · dashed boxes"; color="#b5532a"; style=dashed; margin=22;
    node [style="rounded,dashed,filled", color="#943f1e", fillcolor="#f4ecdf"];

    recovery [label="INDEPENDENT RECOVERY\nOff-instance ledger copy\nRestore/reconciliation rehearsal"];
    deletion -> recovery [label="deployment gate"];
  }
  phrases [label="PHRASE BANKS · versioned JSON\nOriginal EN/ES + approved weekly passages\nNo user FK · fixed weekly publication order", color="#943f1e", penwidth=2];
  browser [label="DEVICE-OWNED\nGuest calendar settings · PNG exports\nNever uploaded by signup alone"];
  users -> prefs [label="opt-in only"];
  users -> deletion [label="confirmed deletion marker; no FK"];
  phrases -> delivery [label="approved weekly content"];
  browser -> profiles [label="explicit import/sync", style=dashed];
}
